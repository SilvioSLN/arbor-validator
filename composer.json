{
    "name": "silviosln/arbor-validator",
    "description": "Biblioteca de validação moderna para PHP 8.3+, agnóstica de framework, combinando a DX do Zod com DTOs tipados e Atributos nativos do PHP.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Silvio Silva",
            "homepage": "https://github.com/silviosln"
        }
    ],
    "keywords": [
        "validator",
        "validation",
        "zod",
        "dto",
        "attributes",
        "php83",
        "cpf",
        "cnpj",
        "arbor"
    ],
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Arbor\\Validator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Arbor\\Validator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
